    "radix-ui": "^1.6.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "^4.12.0",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
